# Database configuration (defaults to SQLite, compatible with PostgreSQL)
DATABASE_URL=sqlite:///./retail.db
# For PostgreSQL:
# DATABASE_URL=postgresql://retail_user:secretpassword@localhost:5432/retail

# Application environment
ENV=development
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://127.0.0.1:8000

# Model Paths
MODEL_ARTIFACT_PATH=models/xgboost_forecaster.joblib
PREPROCESSOR_ARTIFACT_PATH=models/feature_pipeline.joblib
METRICS_REPORT_PATH=models/model_metrics.json

# Default Inventory Policy
DEFAULT_SERVICE_LEVEL=0.95
DEFAULT_LEAD_TIME_DAYS=7
DEFAULT_REVIEW_PERIOD_DAYS=7
